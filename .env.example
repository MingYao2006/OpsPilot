# ================= OpsPilot 配置模板 =================
# 复制为 .env 后填写。所有变量以 OPSPILOT_ 为前缀。

# ---------- LLM：DeepSeek ----------
OPSPILOT_LLM_PROVIDER=deepseek
OPSPILOT_LLM_MODEL=deepseek-chat
# 在 https://platform.deepseek.com 申请，填在这里（不要提交到 git）
OPSPILOT_LLM_API_KEY=sk-在此填入你的DeepSeek密钥
# 可选：留空则用默认 https://api.deepseek.com/v1
OPSPILOT_LLM_BASE_URL=
# 结构化输出。DeepSeek 支持 response_format=json_object，建议保持 true
OPSPILOT_LLM_JSON_MODE=true
OPSPILOT_LLM_TEMPERATURE=0.1

# ---------- Embedding ----------
# 重要：DeepSeek 不提供 embedding 接口，必须单独选择来源。
#   local  = 内置哈希向量器，零依赖、可离线，开发与测试用（默认）
#   ollama = 本地模型，需先 `ollama pull nomic-embed-text`
#   openai = 任意 OpenAI 兼容 embedding 服务（SiliconFlow / DashScope / Jina / 智谱 / vLLM）
OPSPILOT_EMBEDDING_PROVIDER=local
OPSPILOT_EMBEDDING_MODEL=nomic-embed-text
OPSPILOT_EMBEDDING_DIM=512
# 切换到 openai 时填写：
OPSPILOT_EMBEDDING_API_KEY=
OPSPILOT_EMBEDDING_BASE_URL=
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434

# ---------- 向量库：memory | qdrant | pgvector ----------
OPSPILOT_VECTOR_BACKEND=memory
OPSPILOT_QDRANT_URL=http://localhost:6333
OPSPILOT_QDRANT_COLLECTION=opspilot
OPSPILOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/opspilot

# ---------- 知识库 ----------
OPSPILOT_KNOWLEDGE_DIR=data/kb
OPSPILOT_AUTOLOAD_KNOWLEDGE=true

# ---------- 检索 ----------
OPSPILOT_CHUNK_SIZE=480
OPSPILOT_CHUNK_OVERLAP=80
OPSPILOT_TOP_K=8
OPSPILOT_RERANK_TOP_N=5
OPSPILOT_RRF_K=60
# 注意：这是**向量阶段**的余弦阈值（0~1 量纲），只用于过滤向量召回结果。
# 不要拿它去卡融合后的 RRF 分 —— RRF 上限只有 2/(RRF_K+1)≈0.033，用它过滤会恒为真。
OPSPILOT_MIN_RELEVANCE=0.06

# ---------- 可信与安全 ----------
# 引用校验：对 LLM 答复强制检查数字一致性/引用存在性/句子支撑度，
# 未通过则带原因重试，仍不通过转人工拒答。关掉可对比"裸生成"的差别。
OPSPILOT_VERIFY_CITATIONS=true
OPSPILOT_MIN_CONFIDENCE=0.35
OPSPILOT_MIN_CITATION_SUPPORT=0.25

# ---------- 可选鉴权（留空则不校验）----------
OPSPILOT_JWT_SECRET=

# ---------- 限流（默认关闭；开启后按客户端滑动窗口）----------
# 开启后：同一客户端在 OPSPILOT_RATE_LIMIT_WINDOW 秒内最多 OPSPILOT_RATE_LIMIT 个请求，超出返回 429
OPSPILOT_RATE_LIMIT_ENABLED=false
OPSPILOT_RATE_LIMIT=30
OPSPILOT_RATE_LIMIT_WINDOW=60
